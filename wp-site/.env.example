# --- WordPress REST API 接続設定 ---
# Xserver にインストールした WordPress サイトの URL（末尾スラッシュなし）
WP_BASE_URL=https://matsumotorentacar.com

# WordPress のログインユーザー名（管理者など投稿権限のあるユーザー）
WP_USERNAME=your-wp-username

# アプリケーションパスワード（通常のログインパスワードではありません）
# 取得方法: WordPress管理画面 → ユーザー → プロフィール → 「アプリケーションパスワード」
#   1. 「新しいアプリケーションパスワード名」に任意の名前（例: wp-site-tool）を入力
#   2. 「新しいアプリケーションパスワードを追加」をクリック
#   3. 表示された "xxxx xxxx xxxx xxxx xxxx xxxx" を下にそのまま貼り付け（スペースありでOK）
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- SEO 設定 ---
# 使用中の SEO プラグイン: rankmath / yoast / seopress / none
# メタタイトル・メタディスクリプション・フォーカスキーワードの書き込み先が変わります。
SEO_PLUGIN=rankmath
