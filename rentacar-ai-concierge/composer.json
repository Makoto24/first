{
    "name": "rcac/rentacar-ai-concierge",
    "description": "WordPress plugin: chatbot and contact form for rental car sites powered by the Claude API",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "anthropic-ai/sdk": "^0.55",
        "nyholm/psr7": "^1.8"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
